# Cloudflare에서는 Settings > Variables and Secrets에 암호화된 Secret으로 등록하세요.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=replace_with_available_model

# 단가. 없으면 cost_micro가 0으로 기록되고 AI_PROPOSAL_COST_CAP_USD 상한이
# 아예 동작하지 않는다(server/ai-usage.js의 budgetState에서 priced가 거짓이면 비용 항이 빠진다).
# 값은 1M 토큰당 미국 달러. 모델을 바꾸면 이 셋도 함께 바꿔야 한다.
# gpt-5.6-sol 기준(developers.openai.com/api/docs/pricing, 2026-08-19 확인):
OPENAI_PRICE_INPUT_PER_MTOK=5.0
OPENAI_PRICE_CACHED_INPUT_PER_MTOK=0.5
OPENAI_PRICE_OUTPUT_PER_MTOK=30.0

# 상한. 넣지 않으면 server/ai-usage.js의 DEFAULT_CAPS를 쓴다.
# 계획서 한 건당 비용·토큰, 계정 하루 토큰 순서다.
AI_PROPOSAL_COST_CAP_USD=20
AI_PROPOSAL_TOKEN_CAP=2000000
AI_USER_DAILY_TOKEN_CAP=6000000
